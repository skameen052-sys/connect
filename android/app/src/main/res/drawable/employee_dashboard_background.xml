<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MAIN BACKGROUND -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F8FBFA" />
        </shape>
    </item>


    <!-- ================================================= -->
    <!-- TOP LEFT GREEN CURVED AREA -->
    <!-- ================================================= -->

    <item
        android:width="360dp"
        android:height="360dp"
        android:gravity="top|start"
        android:left="-90dp"
        android:top="-80dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:centerX="0.65"
                android:centerY="0.65"
                android:gradientRadius="180dp"
                android:startColor="#087F5B"
                android:centerColor="#20A879"
                android:endColor="#BFE8D8" />

        </shape>

    </item>


    <!-- ================================================= -->
    <!-- TOP LEFT SOFT WHITE CURVE -->
    <!-- ================================================= -->

    <item
        android:width="280dp"
        android:height="280dp"
        android:gravity="top|start"
        android:left="100dp"
        android:top="-100dp">

        <shape android:shape="oval">

            <solid android:color="#90FFFFFF" />

        </shape>

    </item>


    <!-- ================================================= -->
    <!-- TOP RIGHT NAVY BLUE SOFT CIRCLE -->
    <!-- ================================================= -->

    <item
        android:width="260dp"
        android:height="260dp"
        android:gravity="top|end"
        android:right="-100dp"
        android:top="55dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:centerX="0.45"
                android:centerY="0.5"
                android:gradientRadius="130dp"
                android:startColor="#DCE8F5"
                android:centerColor="#E8F0F8"
                android:endColor="#F3F7FA" />

        </shape>

    </item>


    <!-- ================================================= -->
    <!-- TOP RIGHT SMALL GOLD ACCENT -->
    <!-- ================================================= -->

    <item
        android:width="90dp"
        android:height="90dp"
        android:gravity="top|end"
        android:right="30dp"
        android:top="35dp">

        <shape android:shape="oval">

            <solid android:color="#F2D58A" />

        </shape>

    </item>


    <!-- ================================================= -->
    <!-- BOTTOM LEFT SOFT BLUE CIRCLE -->
    <!-- ================================================= -->

    <item
        android:width="370dp"
        android:height="370dp"
        android:gravity="bottom|start"
        android:left="-150dp"
        android:bottom="-70dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:centerX="0.7"
                android:centerY="0.35"
                android:gradientRadius="185dp"
                android:startColor="#D9E7F5"
                android:centerColor="#E7F0F8"
                android:endColor="#F4F8FB" />

        </shape>

    </item>


    <!-- ================================================= -->
    <!-- BOTTOM RIGHT GREEN / BLUE DECORATION -->
    <!-- ================================================= -->

    <item
        android:width="390dp"
        android:height="390dp"
        android:gravity="bottom|end"
        android:right="-150dp"
        android:bottom="-110dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:centerX="0.35"
                android:centerY="0.35"
                android:gradientRadius="195dp"
                android:startColor="#0B8064"
                android:centerColor="#38A88A"
                android:endColor="#BFDCD5" />

        </shape>

    </item>


    <!-- ================================================= -->
    <!-- SOFT GOLD BOTTOM ACCENT -->
    <!-- ================================================= -->

    <item
        android:width="170dp"
        android:height="170dp"
        android:gravity="bottom|end"
        android:right="45dp"
        android:bottom="35dp">

        <shape android:shape="oval">

            <solid android:color="#22E4C36A" />

        </shape>

    </item>


    <!-- ================================================= -->
    <!-- VERY LIGHT CENTER GLOW -->
    <!-- ================================================= -->

    <item
        android:width="330dp"
        android:height="330dp"
        android:gravity="center">

        <shape android:shape="oval">

            <solid android:color="#10FFFFFF" />

        </shape>

    </item>

</layer-list>